# ==========================================
# Sattva Living - Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# For local cluster: postgresql://postgres:postgres@localhost:5433/sattva_db?schema=public
# For standard port: postgresql://postgres:postgres@localhost:5432/sattva_db?schema=public
DATABASE_URL=postgresql://postgres@localhost:5433/sattva_db?schema=public

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Initial Administrator Seed Credentials
ADMIN_NAME="Sattva Store Administrator"
ADMIN_EMAIL=admin@sattvaliving.com
ADMIN_PASSWORD=Admin@Sattva2026!

# AI Integration (Optional: Gemini API)
# Leave empty or unset to automatically activate the built-in catalog matcher fallback
GEMINI_API_KEY=

# Store Branding
BRAND_NAME="Sattva Living"
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
