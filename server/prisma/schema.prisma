generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  role         Role             @default(CUSTOMER)
  phone        String?
  address      String?
  city         String?
  state        String?
  postalCode   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orders       Order[]
  events       AnalyticsEvent[]

  @@index([email])
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String
  image        String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([slug])
}

model Product {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  description      String
  price            Int // Stored in minor currency units (paise), e.g. 149900 = ₹1,499.00
  compareAtPrice   Int? // Optional original price in paise for strikethrough comparison
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  images           String // JSON-serialized string of image URLs
  stock            Int         @default(0)
  material         String
  dimensions       String
  careInstructions String
  intendedUse      String
  experienceLevel  String      @default("ALL_LEVELS") // BEGINNER, INTERMEDIATE, ADVANCED, ALL_LEVELS
  isFeatured       Boolean     @default(false)
  isBestseller     Boolean     @default(false)
  isActive         Boolean     @default(true) // Active or discontinued
  collectionTags   String      @default("[]") // JSON string of tags e.g. ["eco-friendly", "sacred-space"]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique // e.g. SL-2026-0001
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String
  city           String
  state          String
  postalCode     String
  subtotal       Int // in paise
  deliveryCharge Int // in paise
  totalAmount    Int // in paise
  status         OrderStatus @default(CONFIRMED)
  paymentMethod  String      @default("SIMULATED_CHECKOUT")
  paymentStatus  String      @default("SIMULATED_PAID")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  productImage String
  unitPrice    Int // purchase-time price in paise
  quantity     Int
  subtotal     Int // unitPrice * quantity in paise

  @@index([orderId])
  @@index([productId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String // PAGE_VIEW, PRODUCT_VIEW, SEARCH, FILTER_APPLIED, ADD_TO_CART, CHECKOUT_STARTED, ORDER_COMPLETED
  eventData String? // JSON metadata
  sessionId String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([sessionId])
  @@index([createdAt])
}
